{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "",
    "timestamp": false
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "Local_DNS",
        "prefer_go": true,
        "detour": "Direct"
      },
      {
        "type": "hosts",
        "tag": "DNS_hosts",
        "predefined": {
          "dns.alidns.com": ["223.5.5.5", "223.6.6.6", "2400:3200::1", "2400:3200:baba::1"],
          "dns.adguard-dns.com": ["94.140.14.14", "94.140.15.15"]
        }
      },
      {
        "type": "h3",
        "tag": "Direct_DNS",
        "server": "dns.alidns.com",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "Direct",
        "domain_resolver": "DNS_hosts"
      },
      {
        "type": "quic",
        "tag": "Remote_DNS",
        "server": "dns.adguard-dns.com",
        "server_port": 853,
        "detour": "🎯手动选择",
        "domain_resolver": "DNS_hosts"
      },
      {
        "type": "fakeip",
        "tag": "Fake_DNS",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "server": "Local_DNS"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "Direct_DNS"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "Fake_DNS"
      },
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": ["geosite-category-stun", "geosite-category-voip", "geosite-category-ntp"]
          },
          {
            "rule_set": ["geosite-cn"],
            "invert": true
          }
        ],
        "action": "route",
        "server": "Remote_DNS"
      },
      {
        "rule_set": ["geosite-telegram"],
        "action": "route",
        "server": "Remote_DNS"
      },
      {
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "route",
        "server": "Fake_DNS"
      },
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "server": "Direct_DNS"
      },
      {
        "action": "evaluate",
        "server": "Remote_DNS",
        "tag": "No_matches",
        "disable_cache": false,
        "disable_optimistic_cache": false
      },
      {
        "match_response": "No_matches",
        "ip_cidr": ["0.0.0.0"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "match_response": "No_matches",
        "rule_set": "geoip-cn",
        "action": "route",
        "server": "Direct_DNS"
      },
      {
        "match_response": "No_matches",
        "action": "respond"
      }
    ],
    "final": "Remote_DNS",
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "cache_capacity": 2048,
    "optimistic": true,
    "reverse_mapping": true
  },
  "ntp": {
    "enabled": false,
    "server": "ntp.ntsc.ac.cn",
    "server_port": 123,
    "interval": "1h",
    "detour": "Direct",
    "domain_resolver": "Direct_DNS"
  },
  "certificate": {
    "store": "mozilla"
  },
  "http_clients": [
    {
      "tag": "HTTP-Direct",
      "engine": "go",
      "version": 2,
      "disable_version_fallback": false,
      "headers": {},
      "detour": "Direct",
      "tcp_fast_open": true,
      "disable_tcp_keep_alive": true,
      "domain_resolver": "Direct_DNS"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "Mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 8118,
      "tcp_fast_open": true,
      "disable_tcp_keep_alive": false,
      "tcp_keep_alive": "2m",
      "tcp_keep_alive_interval": "30s",
      "udp_fragment": false,
      "udp_timeout": "2m",
      "set_system_proxy": true
    },
    {
      "type": "tun",
      "tag": "Tun-in",
      "interface_name": "utun0",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true,
      "udp_timeout": "2m",
      "udp_mapping": "endpoint_independent",
      "udp_filtering": "endpoint_independent",
      "udp_nat_max": 0,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🎯手动选择",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🔤Google",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🤖AI",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "✈️Telegram SG",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "✈️Telegram NL",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "✈️Telegram US",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🍎Apple",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "📺bilibili",
      "outbounds": [
        "Direct"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "Direct",
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "disable_tcp_keep_alive": false,
      "tcp_keep_alive": "2m",
      "tcp_keep_alive_interval": "30s"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": ["geosite-private"],
        "action": "resolve"
      },
      {
        "rule_set": ["geoip-private"],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "🎯手动选择"
      },
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "reject",
        "method": "default"
      },
      {
        "rule_set": ["geosite-google"],
        "action": "route",
        "outbound": "🔤Google"
      },
      {
        "rule_set": ["geosite-category-ai-!cn"],
        "action": "route",
        "outbound": "🤖AI"
      },
      {
        "rule_set": ["geosite-telegram"],
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geoip-telegram"
          },
          {
            "rule_set": "geoip-sg"
          }
        ],
        "action": "route",
        "outbound": "✈️Telegram SG"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geoip-telegram"
          },
          {
            "rule_set": "geoip-nl"
          }
        ],
        "action": "route",
        "outbound": "✈️Telegram NL"
      },
      {
        "rule_set": "geoip-telegram",
        "action": "route",
        "outbound": "✈️Telegram US"
      },
      {
        "rule_set": ["geosite-apple"],
        "action": "route",
        "outbound": "🍎Apple"
      },
      {
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "route",
        "outbound": "🎯手动选择"
      },
      {
        "rule_set": ["geosite-bilibili"],
        "action": "route",
        "outbound": "📺bilibili"
      },
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "action": "resolve",
        "disable_cache": false,
        "disable_optimistic_cache": false
      },
      {
        "rule_set": ["geoip-cn"],
        "action": "route",
        "outbound": "Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-category-stun",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-category-voip",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ntp",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ai-!cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-apple",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-bilibili",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/appshubcc/bett-rules@sing/geo/geoip/private.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/appshubcc/bett-rules@sing/geo/geoip/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-sg",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/appshubcc/bett-rules@sing/geo/geoip/sg.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-nl",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/appshubcc/bett-rules@sing/geo/geoip/nl.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/appshubcc/bett-rules@sing/geo/geoip/telegram.srs",
        "update_interval": "1d"
      }
    ],
    "final": "🎯手动选择",
    "auto_detect_interface": true,
    "default_http_client": "HTTP-Direct",
    "default_domain_resolver": "Direct_DNS"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "config",
      "store_fakeip": true,
      "store_dns": true
    }
  }
}
